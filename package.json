{
  "name": "ot-network-studio",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src/engine",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "otns": "tsx tools/otns.ts",
    "test:py": "python3 -m unittest discover -s tools",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "@playwright/test": "1.55.1"
  },
  "description": "Design, check and simulate OT / ICS network architectures: IEC 62443 zones and conduits, rule matrix, compromise simulation."
}
